<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\ZylxEmu.LibAtrac9\ZylxEmu.LibAtrac9.csproj" />
    <ProjectReference Include="..\ZylxEmu.HLE\ZylxEmu.HLE.csproj" />
    <ProjectReference Include="..\ZylxEmu.Logging\ZylxEmu.Logging.csproj" />
    <ProjectReference Include="..\ZylxEmu.ShaderCompiler\ZylxEmu.ShaderCompiler.csproj" />
    <ProjectReference Include="..\ZylxEmu.ShaderCompiler.Metal\ZylxEmu.ShaderCompiler.Metal.csproj" />
    <ProjectReference Include="..\ZylxEmu.ShaderCompiler.Vulkan\ZylxEmu.ShaderCompiler.Vulkan.csproj" />
    <!-- SysAbi export generator + analyzers (compile-time registry, NID validation). -->
    <ProjectReference Include="..\ZylxEmu.SourceGenerators\ZylxEmu.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The PS5 symbol catalog: lets the analyzer flag export names it doesn't know. -->
    <AdditionalFiles Include="..\..\scripts\ps5_names.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZylxEmu.Libs.Tests" />
    <InternalsVisibleTo Include="ZylxEmu.Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" />
    <PackageReference Include="NLayer" />
    <PackageReference Include="ppy.SDL3-CS" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" />
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
